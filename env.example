NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Cadence Fix Feature Flag
NEXT_PUBLIC_USE_CADENCE_FIX=true

# Batch Period Map Feature Flag (eliminates N+1 fetch loops)
NEXT_PUBLIC_USE_BATCH_PERIOD_MAP=true

# Debug Payments (keep off by default)
NEXT_PUBLIC_DEBUG_PAYMENTS=false

# V3 Tenant Communication Center (server-only; default off)
V3_TENANT_COMMUNICATIONS_ENABLED=false
# Set SMS_PROVIDER=mock for local/preview sends without Twilio
# SMS_PROVIDER=mock
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_MESSAGING_SERVICE_SID=
# TWILIO_PHONE_NUMBER=
# TWILIO_WEBHOOK_BASE_URL=https://your-preview-or-prod-host
